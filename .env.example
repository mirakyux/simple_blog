# Site Configuration
VITE_SITE_TITLE="My Custom Blog"
VITE_SITE_DESCRIPTION="A vast wilderness, a profound void. Within this expanse, the spark of creation awaits, contingent only upon the hour mirakyux transcends their own stillness."
VITE_SITE_URL="https://example.com"
VITE_AUTHOR_NAME="Your Name"
VITE_AUTHOR_EMAIL="your@email.com"
VITE_LANGUAGE="en"

# Navbar Links (JSON format)
VITE_NAV_LINKS='[{"label":"Articles","url":"#"},{"label":"Timeline","url":"#timeline"},{"label":"Tags","url":"#tags"},{"label":"2025 Review","url":"#year-review"}]'

# LLM Configuration (Optional)
VITE_LLM_PROVIDER=chatgpt # or gemini
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
LLM_MODEL=gpt-4o-mini # or gemini-1.5-flash, or custom model ID
LLM_BASE_URL=https://api.openai.com/v1 # optional custom base URL
